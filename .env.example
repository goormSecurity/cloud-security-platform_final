# ============================================================
# AWS 자격증명  ★ waf_collect / ct_collect / prowler 에 필요
# ============================================================
# 발급 위치: AWS 콘솔 → IAM → 사용자 → 보안 자격 증명 → 액세스 키 만들기
# 필요 권한: AmazonWAFReadOnlyAccess, CloudTrailReadOnlyAccess,
#            AmazonS3ReadOnlyAccess, IAMReadOnlyAccess
#
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=ap-northeast-2

# ============================================================
# GitHub Token  ★ pr_collector / auto_pr 에 필요
# ============================================================
# 발급 위치: GitHub → Settings → Developer settings
#            → Personal access tokens → Tokens (classic) → Generate new token
# 필요 scope: repo (PR 읽기·쓰기)
#
GITHUB_TOKEN=ghp_...

# ============================================================
# AbuseIPDB  (선택 — 없어도 파이프라인 돌아감)
# ============================================================
# 발급 위치: https://www.abuseipdb.com/register?plan=free
# 무료 1,000건/일. analyzer가 IP 위험도 보강에 사용
#
ABUSEIPDB_API_KEY=

# ============================================================
# Grafana  (monitoring/ 도커 컴포즈용, 선택)
# ============================================================
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=admin123!
