# ====================================
# AWS 설정
# ====================================
# AWS 계정 ID (선택사항, 기본값은 config.py에서 관리)
# AWS_ACCOUNT_ID=123456789012
# AWS_REGION=ap-northeast-2

# ====================================
# 분석 엔진 설정 (analyzer/)
# ====================================
# AbuseIPDB API 키 (선택사항)
# IP의 악의적 활동 여부를 확인하여 위험도에 추가 반영
# 무료 요금제: 1000건/일
# 가입: https://www.abuseipdb.com/register?plan=free
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# ====================================
# Grafana 설정 (monitoring/)
# ====================================
# Grafana 관리자 계정 (기본값: admin/admin123!)
# 운영 환경에서는 반드시 변경하세요!
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=your_secure_password_here

# ====================================
# 로깅 및 디버깅
# ====================================
# DEBUG=false
# LOG_LEVEL=INFO
