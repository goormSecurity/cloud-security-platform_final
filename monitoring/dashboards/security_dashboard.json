          { "name": "request_count", "jsonPath": "$.[*].request_count", "type": "number" },
          { "name": "blocked",       "jsonPath": "$.[*].blocked",       "type": "number" },
          { "name": "block_rate_pct","jsonPath": "$.[*].block_rate_pct","type": "number" },
          { "name": "attack_types",  "jsonPath": "$.[*].attack_types",  "type": "string" }
