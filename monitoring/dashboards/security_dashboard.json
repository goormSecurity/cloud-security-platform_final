      "gridPos": { "x": 0, "y": 26, "w": 16, "h": 10 },
      "datasource": { "type": "marcusolsson-json-datasource", "uid": "afot70vnoy7swf" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "risk_level" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "HIGH":    { "color": "#ef5350", "index": 0, "text": "HIGH" } } },
                { "type": "value", "options": { "MEDIUM":  { "color": "#ffa726", "index": 1, "text": "MEDIUM" } } },
                { "type": "value", "options": { "LOW":     { "color": "#66bb6a", "index": 2, "text": "LOW" } } }
