      "datasource": { "type": "marcusolsson-json-datasource", "uid": "afot70vnoy7swf" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#4fc3f7" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#4fc3f7", "value": 0 }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "center" },
      "targets": [{
        "refId": "A",
        "fields": [{ "name": "total_requests", "jsonPath": "$.total_requests", "type": "number" }],
        "method": "GET", "urlPath": "/summary"
